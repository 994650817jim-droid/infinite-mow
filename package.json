{
  "name": "infinite-mow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "无限割草：乱世千军 — mobile-first portrait roguelike survivor game",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node tools/build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "pretest:regression": "npm run build",
    "test:regression": "node tools/regression.mjs",
    "pretest:audit": "npm run build",
    "test:audit": "node tools/audit-regression.mjs",
    "test:boss": "node tools/phase8_realboss.mjs",
    "test:mobile": "node tools/mobile-smoke.mjs",
    "test:perf": "node tools/perf-smoke.mjs",
    "pretest:chapter": "npm run build",
    "test:chapter": "node tools/chapter-regression.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
